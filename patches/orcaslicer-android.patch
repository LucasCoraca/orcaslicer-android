+// ---- OrcaSlicer XR
+
+void GLCanvas3D::xr_render_eye(const Transform3d& view, const Matrix4d& projection, int w, int h, double near_z, double far_z)
+{
+    if (!m_initialized || m_in_render || m_xr_eye || m_canvas == nullptr || w <= 0 || h <= 0)
+        return;
+    Camera& camera = wxGetApp().plater()->get_camera();
+    const Camera saved = camera;
+    camera.set_external(view, projection, w, h, near_z, far_z);
+    m_xr_eye = true;
+    Slic3r::ScopeGuard restore([this, &camera, &saved]() { m_xr_eye = false; camera = saved; });
+    // the eye's framebuffer is what passes that draw elsewhere (shadow maps) return to
+    OpenGLManager::capture_default_framebuffer();
+    glsafe(::glViewport(0, 0, w, h));
+    _render_scene(camera, Size(w, h, get_scale()));
+}
+
+Camera GLCanvas3D::xr_ray_camera(const Vec3d& origin, const Vec3d& dir, Vec2d* mouse) const
+{
+    const Size& cnv_size = get_canvas_size();
+    const int w = std::max(10, cnv_size.get_width()), h = std::max(10, cnv_size.get_height());
+    // 90 degrees tall (about h / 90 pixels a degree): a drag stays well inside it
+    const double t = std::tan(0.25 * M_PI), aspect = double(w) / double(h), near_z = 1.0, far_z = 1.0e6;
+    const Vec3d d = dir.normalized();
+    // looking down the ray, up as close to +Z as it gets
+    Vec3d z = -d, up = std::abs(d.z()) > 0.99 ? Vec3d::UnitY() : Vec3d::UnitZ();
+    Vec3d x = up.cross(z).normalized(), y = z.cross(x);
+    Matrix3d r0; r0.col(0) = x; r0.col(1) = y; r0.col(2) = z;
+    Eigen::Quaterniond rot(r0);
+    Vec2d m(0.5 * w, 0.5 * h);
+    if (m_xr_pressed) {
+        // a drag: the mouse moves by how far the ray turned since the press (as seen by the press' camera), and the camera
+        // at the ray now is turned so that the line of sight through that pixel is the ray
+        const Vec3d v = m_xr_press_rot.conjugate() * d;
+        if (v.z() < -1e-3) {
+            m = Vec2d(0.5 * w * (1.0 + v.x() / -v.z() / (t * aspect)), 0.5 * h * (1.0 - v.y() / -v.z() / t));
+            const Vec3d through = Vec3d((m.x() / w * 2.0 - 1.0) * t * aspect, (1.0 - m.y() / h * 2.0) * t, -1.0).normalized();
+            rot = rot * Eigen::Quaterniond::FromTwoVectors(through, -Vec3d::UnitZ());
+        }
+    }
+    Transform3d view = Transform3d::Identity();
+    view.linear() = rot.conjugate().toRotationMatrix();
+    view.translation() = -(view.linear() * origin);
+    Matrix4d proj = Matrix4d::Zero();
+    proj(0, 0) = 1.0 / (t * aspect); proj(1, 1) = 1.0 / t;
+    proj(2, 2) = -(far_z + near_z) / (far_z - near_z); proj(2, 3) = -2.0 * far_z * near_z / (far_z - near_z); proj(3, 2) = -1.0;
+    Camera c = wxGetApp().plater()->get_camera();
+    c.set_external(view, proj, w, h, near_z, far_z);
+    if (mouse != nullptr)
+        *mouse = m;
+    return c;
+}
+
+double GLCanvas3D::xr_hit(const Vec3d& origin, const Vec3d& dir)
+{
+    if (!m_initialized)
+        return -1.0;
+    Vec2d m;
+    const bool pressed = m_xr_pressed;
+    m_xr_pressed = false;
+    const Camera c = xr_ray_camera(origin, dir, &m);
+    m_xr_pressed = pressed;
+    const ClippingPlane clipping_plane = get_raycaster_clipping_plane();
+    const SceneRaycaster::HitResult hit = m_scene_raycaster.hit(m, c, &clipping_plane);
+    return hit.is_valid() ? (hit.position.cast<double>() - origin).norm() : -1.0;
+}
+
+void GLCanvas3D::xr_pointer(int action, const Vec3d& origin, const Vec3d& dir)
+{
+    if (!m_initialized || m_canvas == nullptr || !_set_current())
+        return;
+    if (action == 4 || action == 6) {
+        // the ray left the scene (or two hands took over): the screen's mouse again
+        if (m_xr_pressed && action == 6) {
+            m_xr_pressed = false;
+            mouse_up_cleanup();
+            m_mouse.set_start_position_2D_as_invalid();
+            m_mouse.set_start_position_3D_as_invalid();
+        }
+        if (!m_xr_pointer || m_xr_pressed)
+            return;
+        m_xr_pointer = false;
+        m_mouse.position = Vec2d(-1.0, -1.0);
+        m_hover_volume_idxs.clear();
+        m_hover_plate_idxs.clear();
+        wxGetApp().plater()->get_partplate_list().reset_hover_id();
+        m_gizmos.set_hover_id(-1);
+        _update_volumes_hover_state();
+        m_dirty = true;
+        return;
+    }
+    Vec2d mouse;
+    const Camera ray = xr_ray_camera(origin, dir, &mouse);
+    if (action == 0) {
+        m_xr_pressed = true;
+        m_xr_press_dir = dir.normalized();
+        m_xr_press_rot = Eigen::Quaterniond(ray.get_view_matrix().linear().transpose());
+    }
+    if (!m_xr_pointer && GImGui != nullptr)
+        ImGui::GetIO().MousePos = ImVec2(-FLT_MAX, -FLT_MAX);   // the overlays lose the screen's mouse
+    m_xr_pointer = true;
+    m_xr_ray_camera = ray;
+
+    Camera& camera = wxGetApp().plater()->get_camera();
+    const Camera saved = camera;
+    camera = ray;
+    s_xr_room_event = true;
+    Slic3r::ScopeGuard restore([&camera, &saved]() { s_xr_room_event = false; camera = saved; });
+    m_mouse.position = mouse;
+    if (action == 0 || action == 3)
+        _picking_pass();
+#if ENABLE_RETINA_GL
+    const double scale = m_retina_helper->get_scale_factor();
+#else
+    const double scale = 1.0;
+#endif
+    auto send = [this, &mouse, scale](wxEventType type, bool left, bool right) {
+        wxMouseEvent evt(type);
+        evt.SetEventObject(m_canvas);
+        evt.SetX(int(std::lround(mouse.x() / scale)));
+        evt.SetY(int(std::lround(mouse.y() / scale)));
+        evt.SetLeftDown(left);
+        evt.SetRightDown(right);
+        on_mouse(evt);
+    };
+    switch (action) {
+    case 0: send(wxEVT_LEFT_DOWN, true, false); break;
+    case 1: send(wxEVT_MOTION, true, false); break;
+    case 2: send(wxEVT_LEFT_UP, false, false); m_xr_pressed = false; break;
+    case 3: send(wxEVT_MOTION, false, false); break;
+    case 5: send(wxEVT_RIGHT_DOWN, false, true); send(wxEVT_RIGHT_UP, false, false); break;
+    default: break;
+    }
+    m_dirty = true;
+}
