+#version 300 es
+precision highp float;
+precision highp int;
+precision highp sampler2D;
+
+const vec3 ZERO = vec3(0.0, 0.0, 0.0);
+
+uniform vec4 uniform_color;
+
+in vec3 clipping_planes_dots;
+
+out vec4 out_color;
+
