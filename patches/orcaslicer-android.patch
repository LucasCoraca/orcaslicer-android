diff --git a/deps/deps-android.cmake b/deps/deps-android.cmake
new file mode 100644
index 000000000..675542065
--- /dev/null
+++ b/deps/deps-android.cmake
@@ -0,0 +1,23 @@
+# Android (NDK) dependency bundle: engine-side libraries only.
+# GUI-only deps (wxWidgets, GLFW, FFMPEG, DataChannel, embedded Python) are skipped.
+# TOOLCHAIN_PREFIX is consumed by the autotools-based deps (GMP/MPFR/OpenSSL).
+if (ANDROID_ABI STREQUAL "arm64-v8a")
+    set(TOOLCHAIN_PREFIX aarch64-linux-android)
+elseif (ANDROID_ABI STREQUAL "x86_64")
+    set(TOOLCHAIN_PREFIX x86_64-linux-android)
+else ()
+    message(FATAL_ERROR "Unsupported ANDROID_ABI ${ANDROID_ABI}")
+endif ()
+set(DEP_CMAKE_OPTS "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
+                   "-DANDROID_ABI=${ANDROID_ABI}"
+                   "-DANDROID_PLATFORM=${ANDROID_PLATFORM}"
+                   "-DANDROID_STL=${ANDROID_STL}"
+                   # the NDK toolchain restricts find_* to its sysroot; make our prefix part of it
+                   "-DCMAKE_FIND_ROOT_PATH=${DESTDIR}")
+set(ZLIB_FOUND FALSE)
+
+# Bare NDK clang targets the host; the per-API wrappers add --target.
+get_filename_component(_ndk_bin "${CMAKE_C_COMPILER}" DIRECTORY)
+string(REGEX REPLACE "^android-" "" _api "${ANDROID_PLATFORM}")
+set(ANDROID_AUTOTOOLS_CC  "${_ndk_bin}/${TOOLCHAIN_PREFIX}${_api}-clang")
+set(ANDROID_AUTOTOOLS_CXX "${_ndk_bin}/${TOOLCHAIN_PREFIX}${_api}-clang++")
