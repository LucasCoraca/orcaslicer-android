+public:
+    wxQtContentUriExport(const QString& local, const QString& uri) : m_local(local), m_uri(uri)
+    {
+        m_settle.setSingleShot(true);
+        m_settle.setInterval(1500);
+        connect(&m_settle, &QTimer::timeout, this, &wxQtContentUriExport::CopyBack);
+        m_watcher.addPath(QFileInfo(local).absolutePath());
+        connect(&m_watcher, &QFileSystemWatcher::directoryChanged, this, [this] { Touched(); });
+        connect(&m_watcher, &QFileSystemWatcher::fileChanged, this, [this] { Touched(); });
+    }
+
+private:
+    void Touched()
+    {
+        if (QFileInfo::exists(m_local) && !m_watcher.files().contains(m_local))
+            m_watcher.addPath(m_local);
+        m_settle.start();
+    }
+
+    void CopyBack()
+    {
+        const QFileInfo info(m_local);
+        if (!info.exists() || info.lastModified() == m_copied)
+            return;
+        QFile src(m_local);
+        QFile dst(m_uri);
+        if (!src.open(QIODevice::ReadOnly) || !dst.open(QIODevice::WriteOnly | QIODevice::Truncate))
+        {
