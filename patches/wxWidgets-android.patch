+///////////////////////////////////////////////////////////////////////////////
+// Name:        src/qt/secretstore_android.cpp
+// Purpose:     wxSecretStore for Android (Android Keystore via Java bridge)
+// Licence:     wxWindows licence
+///////////////////////////////////////////////////////////////////////////////
+
+#include "wx/wxprec.h"
+
+#if wxUSE_SECRETSTORE && defined(__WXQT__) && defined(__ANDROID__)
+
+#include "wx/secretstore.h"
+#include "wx/private/secretstore.h"
+#include "wx/qt/private/converter.h"
+#include "wx/base64.h"
+
+#include <QtCore/QJniObject>
+#include <QtCore/QCoreApplication>
+
+namespace
+{
+const char* BRIDGE_CLASS = "org/orcaport/wx/SecretStoreBridge";
+
+QJniObject appContext() { return QNativeInterface::QAndroidApplication::context(); }
+
+class wxSecretStoreAndroidImpl : public wxSecretStoreImpl
+{
+public:
+    bool IsOk(wxString* errmsg) const override
+    {
+        if (appContext().isValid())
+            return true;
+        if (errmsg)
+            *errmsg = wxS("no Android context");
+        return false;
+    }
+
+    bool Save(const wxString& service, const wxString& username,
+              const wxSecretValueImpl& password, wxString& errmsg) override
+    {
+        const wxString b64 = wxBase64Encode(password.GetData(), password.GetSize());
+        const jboolean ok = QJniObject::callStaticMethod<jboolean>(BRIDGE_CLASS, "save",
+            "(Landroid/content/Context;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)Z",
+            appContext().object(),
+            QJniObject::fromString(wxQtConvertString(service)).object(),
+            QJniObject::fromString(wxQtConvertString(username)).object(),
+            QJniObject::fromString(wxQtConvertString(b64)).object());
+        if (!ok)
+            errmsg = wxS("Android Keystore write failed");
+        return ok;
+    }
+
+    bool Load(const wxString& service, wxString* username,
+              wxSecretValueImpl** password, wxString& errmsg) const override
+    {
+        QJniObject r = QJniObject::callStaticObjectMethod(BRIDGE_CLASS, "load",
+            "(Landroid/content/Context;Ljava/lang/String;)Ljava/lang/String;",
+            appContext().object(), QJniObject::fromString(wxQtConvertString(service)).object());
+        if (!r.isValid())
+        {
+            // Not an error: nothing stored for this service.
+            return false;
+        }
+        const wxString s = wxQtConvertString(r.toString());
+        const size_t nl = s.find('\n');
+        if (nl == wxString::npos)
+        {
+            errmsg = wxS("corrupt entry");
+            return false;
+        }
+        if (username)
+            *username = s.substr(0, nl);
+        const wxMemoryBuffer buf = wxBase64Decode(s.substr(nl + 1));
+        *password = new wxSecretValueGenericImpl(buf.GetDataLen(), buf.GetData());
+        return true;
+    }
+
+    bool Delete(const wxString& service, wxString& errmsg) override
+    {
+        const jboolean ok = QJniObject::callStaticMethod<jboolean>(BRIDGE_CLASS, "delete",
+            "(Landroid/content/Context;Ljava/lang/String;)Z",
+            appContext().object(), QJniObject::fromString(wxQtConvertString(service)).object());
+        if (!ok)
+            errmsg = wxS("Android Keystore delete failed");
+        return ok;
+    }
+};
+}
+
+/* static */
+wxSecretValueImpl*
+wxSecretValue::NewImpl(size_t size, const void *data, const char* WXUNUSED(contentType))
+{
+    return new wxSecretValueGenericImpl(size, data);
+}
+
+/* static */
+wxSecretStore wxSecretStore::GetDefault()
+{
+    return wxSecretStore(new wxSecretStoreAndroidImpl());
+}
+
+#endif // wxUSE_SECRETSTORE && __WXQT__ && __ANDROID__
