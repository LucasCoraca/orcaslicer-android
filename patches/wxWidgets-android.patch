+    QString name = QFileInfo(uri).fileName();
+    if (name.isEmpty() || name.contains('/'))
+        name = QString::number(qHash(uri), 16);
+    const QString dir = QStandardPaths::writableLocation(QStandardPaths::CacheLocation) + "/export/"
