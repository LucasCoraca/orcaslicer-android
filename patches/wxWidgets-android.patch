+}
+
+void wxQtGLWidget::HandleTouch(QTouchEvent* event)
+{
+    // setAccepted(), not accept(): only the virtual one accepts each point. A finger pressed while another is
+    // down that is left unaccepted is taken away from this widget by Qt, and the pinch never sees it.
+    event->setAccepted(true);
+    const QList<QEventPoint>& points = event->points();
+    // Qt (6.8) remembers this widget as the target of a finger pressed while another is down only when it
+    // found this widget through the closest other active point; when that is a stale point elsewhere, the new
+    // finger is delivered here once and then dropped from every update. Claim it, as Qt does for TouchBegin.
+    for ( const QEventPoint& p : points )
+        if ( p.state() == QEventPoint::Pressed && !QMutableEventPoint::target(p) )
+            QMutableEventPoint::setTarget(const_cast<QEventPoint&>(p), this);
+    QList<QPointF> down;
+    QList<int> downIds;
+    for ( const QEventPoint& p : points )
+        if ( p.state() != QEventPoint::Released )
+        {
+            down.push_back(p.position());
+            downIds.push_back(p.id());
+        }
+
+    const bool finished = event->type() == QEvent::TouchEnd || event->type() == QEvent::TouchCancel;
+    if ( event->type() == QEvent::TouchBegin )
+        m_touchMode = TouchMode::None;
+
+    if ( !finished && down.size() >= 2 )
+    {
+        m_longPress.stop();
+        if ( m_touchMode == TouchMode::Mouse )
+            SendMouse(QEvent::MouseButtonRelease, m_lastMousePos, Qt::NoButton); // end the one-finger drag
+        if ( m_touchMode == TouchMode::Arming )
+            m_touchMode = TouchMode::Done; // the second finger came first: a gesture, not a drag
+        bool start = m_touchMode != TouchMode::Gesture;
+        int a = downIds.indexOf(m_idA), b = downIds.indexOf(m_idB);
+        if ( start || a < 0 || b < 0 )
+        {
+            // a new pair of fingers (or one of them was replaced): measure from here
+            a = 0;
+            b = 1;
+            m_idA = downIds[0];
+            m_idB = downIds[1];
+            start = true;
+        }
+        if ( start && m_touchMode == TouchMode::Gesture )
+            SendGestures(m_lastA, m_lastB, false, true); // end the previous pair's gesture
+        m_touchMode = TouchMode::Gesture;
+        SendGestures(down[a], down[b], start, false);
+        return;
+    }
+
+    if ( m_touchMode == TouchMode::Gesture )
+    {
+        // lifting the fingers ends the gesture; the last one up must not start a drag
+        SendGestures(m_lastA, m_lastB, false, true); // same points: no extra pan, zoom or twist
+
+        m_touchMode = TouchMode::Done;
+    }
+    else if ( m_touchMode == TouchMode::None && !finished && down.size() == 1 )
+    {
+        m_touchMode = TouchMode::Pending;
+        m_touchStart = down[0];
+        m_lastMousePos = down[0];
+        m_touchTime.start();
+        // Hover where the finger is: 3D scenes find the object under the pointer while rendering, so it is
+        // known by the time a tap or long press acts on it.
+        SendMouse(QEvent::MouseMove, m_touchStart, Qt::NoButton);
+        m_longPress.start();
+    }
+    else if ( (m_touchMode == TouchMode::Pending || m_touchMode == TouchMode::Held) && !finished && down.size() == 1 )
+    {
+        // a drag starts once the finger has clearly moved
+        const QPointF moved = down[0] - m_touchStart;
+        if ( std::hypot(moved.x(), moved.y()) > 8.0 )
+            ArmDrag(down[0]);
+    }
+    else if ( m_touchMode == TouchMode::Held && finished )
+    {
+        m_touchMode = TouchMode::None;
+        RightClick(m_touchStart);
+        return;
+    }
+    else if ( m_touchMode == TouchMode::Arming && !finished && down.size() == 1 )
+    {
+        m_lastMousePos = down[0]; // replayed once the drag starts
+    }
+    else if ( m_touchMode == TouchMode::Arming && finished )
+    {
+        m_liftedWhileArming = true; // StartDrag() releases
+        return;
+    }
+    else if ( m_touchMode == TouchMode::Mouse && !finished && down.size() == 1 )
+    {
+        SendMouse(QEvent::MouseMove, down[0], Qt::LeftButton);
+    }
+    else if ( m_touchMode == TouchMode::Pending && finished )
+    {
+        // A tap: a click where the finger went down.
+        m_longPress.stop();
+        m_touchMode = TouchMode::None;
+        const QPointF pos = m_touchStart;
+        QueueSteps({ [this, pos] { SendMouse(QEvent::MouseMove, pos, Qt::NoButton); },
+                     [this, pos] { SendMouse(QEvent::MouseButtonPress, pos, Qt::LeftButton); },
+                     [this, pos] { SendMouse(QEvent::MouseButtonRelease, pos, Qt::NoButton); SendLeave(); } });
+        return;
+    }
+    else if ( m_touchMode == TouchMode::Mouse && finished )
+    {
+        SendMouse(QEvent::MouseButtonRelease, points.isEmpty() ? m_lastMousePos : points.first().position(), Qt::NoButton);
+    }
+
+    if ( finished )
+    {
+        if ( m_steps.empty() )
+            SendLeave();
+        else
+            QueueSteps({ [this] { SendLeave(); } }); // after the long press ends
+        m_touchMode = TouchMode::None;
+    }
+}
