+/////////////////////////////////////////////////////////////////////////////
+// Name:        src/qt/webview_android.cpp
+// Purpose:     wxWebView backend on top of android.webkit.WebView (wxQt on Android)
+// Licence:     wxWindows licence
+/////////////////////////////////////////////////////////////////////////////
+
+#include "wx/wxprec.h"
+
+#if wxUSE_WEBVIEW && defined(__WXQT__) && defined(__ANDROID__)
+
+#include "wx/qt/webview_android.h"
+#include "wx/private/webview.h"
+#include "wx/qt/private/converter.h"
+#include "wx/log.h"
+#include "wx/app.h"
+
+#include "wx/dialog.h"
+#include <QtCore/QJniEnvironment>
+#include <QtCore/QJniObject>
+#include <QtCore/QCoreApplication>
+#include <QtWidgets/QWidget>
+#include <QtWidgets/QApplication>
+
+#include <mutex>
+#include <atomic>
+#include <map>
+
+extern WXDLLIMPEXP_DATA_WEBVIEW(const char) wxWebViewBackendAndroid[] = "wxWebViewAndroid";
+
+namespace
+{
+// keep in sync with WebViewBridge.java
+enum { EV_NAVIGATING, EV_NAVIGATED, EV_LOADED, EV_ERROR, EV_TITLE, EV_NEWWINDOW, EV_MESSAGE, EV_SCRIPT_RESULT, EV_CREATED, EV_BACK };
+
+const char* BRIDGE_CLASS = "org/orcaport/wx/WebViewBridge";
+
+std::mutex                          s_registryMutex;
+std::map<jlong, wxWebViewAndroid*>  s_registry;
+std::atomic<jlong>                  s_nextId{1};
+
+wxString ToWx(const QString& s) { return wxQtConvertString(s); }
+QString  ToQt(const wxString& s) { return wxQtConvertString(s); }
+}
+
+// Gives the bridge (and the native callback) access to the private bits of the control.
+class wxWebViewAndroidImpl
+{
+public:
+    explicit wxWebViewAndroidImpl(wxWebViewAndroid* owner) : owner(owner) {}
+
+    wxWebViewAndroid* owner;
+    jlong             id = 0;
+    QJniObject        bridge;
+    wxString          lastPostedBounds;
+    bool              visible = true;
+    wxVector<wxSharedPtr<wxWebViewHandler>> handlers;
+
+    bool valid() const { return bridge.isValid(); }
+
+    static void onNativeEvent(JNIEnv*, jclass, jlong id, jint type, jstring a, jstring b, jint i);
+    void dispatch(int type, const wxString& a, const wxString& b, int i);
+};
+
+void wxWebViewAndroidImpl::onNativeEvent(JNIEnv*, jclass, jlong id, jint type, jstring a, jstring b, jint i)
+{
+    // Runs on the Android UI thread (or a WebView thread): copy the strings, then hop to the wx thread.
+    const wxString sa = a ? ToWx(QJniObject::fromLocalRef(a).toString()) : wxString();
+    const wxString sb = b ? ToWx(QJniObject::fromLocalRef(b).toString()) : wxString();
+
+    std::lock_guard<std::mutex> lock(s_registryMutex);
+    auto it = s_registry.find(id);
+    if (it == s_registry.end())
+        return;
+    wxWebViewAndroid* view = it->second;
+    wxWebViewAndroidImpl* impl = view->m_impl;
+    view->CallAfter([impl, type, sa, sb, i]() { impl->dispatch(type, sa, sb, i); });
+}
+
+void wxWebViewAndroidImpl::dispatch(int type, const wxString& a, const wxString& b, int i)
+{
+    wxWebViewAndroid* const w = owner;
+    const int wid = w->GetId();
+    wxEventType evtType;
+    wxString url = a, target, handler;
+    wxWebViewNavigationActionFlags flags = wxWEBVIEW_NAV_ACTION_NONE;
+    int intVal = 1;
+    wxString str;
+
+    switch (type)
+    {
+        case EV_CREATED:
+            w->UpdateNativeBounds(true);
+            return;
+        case EV_BACK:
+        {
+            // the system Back key while the page had focus: close the dialog around it, like Escape would
+            if (wxDialog* const dlg = wxDynamicCast(wxGetTopLevelParent(w), wxDialog))
+            {
+                if (dlg->IsModal())
+                    dlg->EndModal(wxID_CANCEL);
+                else
+                    dlg->Close();
+            }
+            return;
+        }
+        case EV_NAVIGATING:
+            evtType = wxEVT_WEBVIEW_NAVIGATING;
+            target = b;
+            flags = i ? wxWEBVIEW_NAV_ACTION_USER : wxWEBVIEW_NAV_ACTION_OTHER;
+            break;
+        case EV_NAVIGATED: evtType = wxEVT_WEBVIEW_NAVIGATED; break;
+        case EV_LOADED:    evtType = wxEVT_WEBVIEW_LOADED;    break;
+        case EV_NEWWINDOW:
+            evtType = wxEVT_WEBVIEW_NEWWINDOW;
+            flags = wxWEBVIEW_NAV_ACTION_USER;
+            break;
+        case EV_TITLE:
+            evtType = wxEVT_WEBVIEW_TITLE_CHANGED;
+            str = a;
+            url = w->GetCurrentURL();
+            break;
+        case EV_MESSAGE:
+        {
+            // a = handler name, b = payload
+            evtType = wxEVT_WEBVIEW_SCRIPT_MESSAGE_RECEIVED;
+            handler = a;
+            url = w->GetCurrentURL();
+            str = b;
+            break;
+        }
+        case EV_ERROR:
+        {
+            evtType = wxEVT_WEBVIEW_ERROR;
+            str = b;
+            intVal = 0;
+            // android.webkit.WebViewClient.ERROR_* -> wxWebViewNavigationError
+            switch (i)
+            {
+                case -2: case -6: case -7: case -8: case -11: intVal = wxWEBVIEW_NAV_ERR_CONNECTION; break;
+                case -11 - 100: intVal = wxWEBVIEW_NAV_ERR_CERTIFICATE; break;
+                case -4: intVal = wxWEBVIEW_NAV_ERR_AUTH; break;
+                case -9: case -12: intVal = wxWEBVIEW_NAV_ERR_SECURITY; break;
+                case -14: intVal = wxWEBVIEW_NAV_ERR_NOT_FOUND; break;
+                case -1: case -3: case -5: case -10: case -13: intVal = wxWEBVIEW_NAV_ERR_REQUEST; break;
+                default: intVal = wxWEBVIEW_NAV_ERR_OTHER; break;
+            }
+            wxWebViewEvent evt(evtType, wid, url, target, flags);
+            evt.SetEventObject(w);
+            evt.SetString(str);
+            evt.SetInt(intVal);
+            w->HandleWindowEvent(evt);
+            return;
+        }
+        case EV_SCRIPT_RESULT:
+        {
+            // a = request id (client data pointer), b = output
+            unsigned long long v = 0;
+            a.ToULongLong(&v);
+            w->SendScriptResult(reinterpret_cast<void*>(static_cast<uintptr_t>(v)), i != 0, b);
+            return;
+        }
+        default:
+            return;
+    }
+
+    wxWebViewEvent evt(evtType, wid, url, target, flags, handler);
+    evt.SetEventObject(w);
+    evt.SetInt(intVal);
+    evt.SetString(str);
+    w->HandleWindowEvent(evt);
+}
+
+// ----------------------------------------------------------------------------
+
+namespace
+{
+bool registerNatives()
+{
+    static bool done = false, ok = false;
+    if (done) return ok;
+    done = true;
+    QJniEnvironment env;
+    static const JNINativeMethod methods[] = {
+        { "nativeEvent", "(JILjava/lang/String;Ljava/lang/String;I)V",
+          reinterpret_cast<void*>(&wxWebViewAndroidImpl::onNativeEvent) },
+    };
+    ok = env.registerNativeMethods(BRIDGE_CLASS, methods, 1);
+    if (!ok)
+        wxLogError("wxWebViewAndroid: cannot register native methods of %s (is the Java bridge in the APK?)", BRIDGE_CLASS);
+    return ok;
+}
+}
+
+wxWebViewAndroid::wxWebViewAndroid()
+{
+    m_impl = new wxWebViewAndroidImpl(this);
+    m_geometryTimer.SetOwner(this);
+    Bind(wxEVT_TIMER, &wxWebViewAndroid::OnGeometryTimer, this);
+}
+
+wxWebViewAndroid::~wxWebViewAndroid()
+{
+    m_geometryTimer.Stop();
+    {
+        std::lock_guard<std::mutex> lock(s_registryMutex);
+        s_registry.erase(m_impl->id);
+    }
+    if (m_impl->valid())
+        m_impl->bridge.callMethod<void>("destroy");
+    delete m_impl;
+}
+
+bool wxWebViewAndroid::Create(wxWindow* parent, wxWindowID id, const wxString& url,
+                              const wxPoint& pos, const wxSize& size, long style, const wxString& name)
+{
+    if (!wxControl::Create(parent, id, pos, size, style, wxDefaultValidator, name))
+        return false;
+
+    if (!registerNatives())
+        return false;
+
+    QJniObject activity = QNativeInterface::QAndroidApplication::context();
+    if (!activity.isValid())
+    {
+        wxLogError("wxWebViewAndroid: no Android activity");
+        return false;
+    }
+
+    m_impl->id = s_nextId++;
+    {
+        std::lock_guard<std::mutex> lock(s_registryMutex);
+        s_registry[m_impl->id] = this;
+    }
+    m_impl->bridge = QJniObject::callStaticObjectMethod(BRIDGE_CLASS, "create",
+        "(Landroid/app/Activity;J)Lorg/orcaport/wx/WebViewBridge;", activity.object(), m_impl->id);
+    if (!m_impl->valid())
+    {
+        wxLogError("wxWebViewAndroid: WebViewBridge.create failed");
+        return false;
+    }
+
+    m_userAgent = ToWx(m_impl->bridge.callObjectMethod("getUserAgent", "()Ljava/lang/String;").toString());
