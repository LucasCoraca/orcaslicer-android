+#ifdef __ANDROID__
+void wxTopLevelWindowQt::DoSetSize(int x, int y, int width, int height, int sizeFlags)
+{
+    const QRect area = wxQtAvailableScreenArea();
+    if ( !wxDynamicCast(this, wxDialog) )
+    {
+        // Frames are the app's screens: they always fill the area the system gives the app.
+        x = area.x();
+        y = area.y();
+        width = area.width();
+        height = area.height();
+        sizeFlags |= wxSIZE_ALLOW_MINUS_ONE;
+    }
+    else
+    {
+        // Dialogs keep their size when it fits, and are pulled back onto the screen otherwise.
+        if ( width > area.width() )
+            width = area.width();
+        if ( height > area.height() )
+            height = area.height();
+        const int w = width > 0 ? width : GetSize().x;
+        const int h = height > 0 ? height : GetSize().y;
+        if ( x != wxDefaultCoord )
+            x = wxMax(area.left(), wxMin(x, area.right() + 1 - w));
+        if ( y != wxDefaultCoord )
+            y = wxMax(area.top(), wxMin(y, area.bottom() + 1 - h));
+    }
+
+    wxTopLevelWindowBase::DoSetSize(x, y, width, height, sizeFlags);
+}
+#endif // __ANDROID__
