diff --git a/src/qt/android/java/org/orcaport/wx/SecretStoreBridge.java b/src/qt/android/java/org/orcaport/wx/SecretStoreBridge.java
new file mode 100644
index 0000000..db339fa
--- /dev/null
+++ b/src/qt/android/java/org/orcaport/wx/SecretStoreBridge.java
@@ -0,0 +1,75 @@
+package org.orcaport.wx;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.security.keystore.KeyGenParameterSpec;
+import android.security.keystore.KeyProperties;
+import android.util.Base64;
+
+import java.nio.charset.StandardCharsets;
+import java.security.KeyStore;
+
+import javax.crypto.Cipher;
+import javax.crypto.KeyGenerator;
+import javax.crypto.SecretKey;
+import javax.crypto.spec.GCMParameterSpec;
+
+/**
+ * Backs wxSecretStore on Android: values are AES-GCM encrypted with a key that lives in the
+ * Android Keystore and the ciphertext is kept in app-private SharedPreferences.
+ */
+public final class SecretStoreBridge {
+    private static final String KEY_ALIAS = "orca_wx_secret_key";
+    private static final String PREFS = "orca_wx_secrets";
+
+    private static SecretKey key() throws Exception {
+        KeyStore ks = KeyStore.getInstance("AndroidKeyStore");
+        ks.load(null);
+        if (ks.containsAlias(KEY_ALIAS))
+            return (SecretKey) ks.getKey(KEY_ALIAS, null);
+        KeyGenerator kg = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore");
+        kg.init(new KeyGenParameterSpec.Builder(KEY_ALIAS, KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
+                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                .setKeySize(256)
+                .build());
+        return kg.generateKey();
+    }
+
+    private static SharedPreferences prefs(Context c) {
+        return c.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /** @param valueB64 the secret, base64 encoded (arbitrary bytes) */
+    public static boolean save(Context c, String service, String user, String valueB64) {
+        try {
+            Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+            cipher.init(Cipher.ENCRYPT_MODE, key());
+            byte[] ct = cipher.doFinal(valueB64.getBytes(StandardCharsets.UTF_8));
+            String blob = Base64.encodeToString(cipher.getIV(), Base64.NO_WRAP) + ":" + Base64.encodeToString(ct, Base64.NO_WRAP);
+            return prefs(c).edit().putString(service + "/user", user).putString(service + "/blob", blob).commit();
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    /** @return "user\nvalueB64" or null when nothing is stored (or it cannot be decrypted) */
+    public static String load(Context c, String service) {
+        try {
+            SharedPreferences p = prefs(c);
+            String blob = p.getString(service + "/blob", null);
+            if (blob == null) return null;
+            String[] parts = blob.split(":");
+            Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+            cipher.init(Cipher.DECRYPT_MODE, key(), new GCMParameterSpec(128, Base64.decode(parts[0], Base64.NO_WRAP)));
+            String value = new String(cipher.doFinal(Base64.decode(parts[1], Base64.NO_WRAP)), StandardCharsets.UTF_8);
+            return p.getString(service + "/user", "") + "\n" + value;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    public static boolean delete(Context c, String service) {
+        return prefs(c).edit().remove(service + "/user").remove(service + "/blob").commit();
+    }
+}
diff --git a/src/qt/android/java/org/orcaport/wx/WebViewBridge.java b/src/qt/android/java/org/orcaport/wx/WebViewBridge.java
new file mode 100644
index 0000000..c9f1810
--- /dev/null
+++ b/src/qt/android/java/org/orcaport/wx/WebViewBridge.java
@@ -0,0 +1,291 @@
+package org.orcaport.wx;
+
+import android.app.Activity;
+import android.graphics.Bitmap;
+import android.os.Message;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.webkit.CookieManager;
+import android.webkit.JavascriptInterface;
+import android.webkit.WebChromeClient;
+import android.webkit.WebResourceError;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebSettings;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import android.widget.FrameLayout;
+
+import org.json.JSONTokener;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Backs wxWebViewAndroid (wxQt on Android). One instance per wx control; the native
+ * android.webkit.WebView is added to the activity content view and positioned over the
+ * wx window by setBounds(). Events travel back through nativeEvent() on whatever thread
+ * Android delivers them (the C++ side re-posts them to the wx main thread).
+ */
+public final class WebViewBridge {
+    // Event types, keep in sync with src/qt/webview_android.cpp
+    static final int EV_NAVIGATING = 0, EV_NAVIGATED = 1, EV_LOADED = 2, EV_ERROR = 3,
+                     EV_TITLE = 4, EV_NEWWINDOW = 5, EV_MESSAGE = 6, EV_SCRIPT_RESULT = 7, EV_CREATED = 8, EV_BACK = 9;
+
+    private static native void nativeEvent(long id, int type, String a, String b, int i);
+
+    private final long id;
+    private final Activity activity;
+    private WebView web;
+    private FrameLayout root;
+    private final FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(1, 1, Gravity.TOP | Gravity.START);
+    private final ArrayList<String> userScripts = new ArrayList<>();
+    private final Map<String, Object> handlers = new HashMap<>();
+    private volatile String url = "", title = "", userAgent = "";
+    private volatile boolean busy, canBack, canForward, destroyed;
+    private boolean visible = true, devTools;
+
+    public static WebViewBridge create(Activity activity, long id) {
+        final WebViewBridge b = new WebViewBridge(activity, id);
+        activity.runOnUiThread(new Runnable() { public void run() { b.init(); } });
+        return b;
+    }
+
+    /** Where the web views go: the view group holding the app's Qt windows. Null: the activity's content view. An app
+     *  showing its Qt windows elsewhere (OrcaSlicer XR: on a virtual display) sets it. */
+    public static volatile FrameLayout contentRoot;
+
+    private WebViewBridge(Activity activity, long id) {
+        this.activity = activity;
+        this.id = id;
+    }
+
+    private void init() {
+        if (destroyed) return;
+        web = new WebView(contentRoot != null ? contentRoot.getContext() : activity);
+        WebSettings s = web.getSettings();
+        s.setJavaScriptEnabled(true);
+        s.setDomStorageEnabled(true);
+        s.setAllowFileAccess(true);
+        s.setAllowFileAccessFromFileURLs(true);
+        s.setAllowUniversalAccessFromFileURLs(true);
+        s.setMixedContentMode(WebSettings.MIXED_CONTENT_ALWAYS_ALLOW);
+        s.setSupportMultipleWindows(true);
+        s.setMediaPlaybackRequiresUserGesture(false);
+        s.setSupportZoom(false);
+        userAgent = s.getUserAgentString();
+        web.setWebViewClient(new Client());
+        web.setWebChromeClient(new Chrome());
+        web.setBackgroundColor(0xFFFFFFFF);
+        // With the page focused, the system Back key reaches this view and never the Qt window: hand it to the
+        // native side, which dismisses the dialog the view lives in.
+        web.setOnKeyListener(new View.OnKeyListener() {
+            @Override public boolean onKey(View v, int keyCode, KeyEvent event) {
+                if (keyCode != KeyEvent.KEYCODE_BACK)
+                    return false;
+                if (event.getAction() == KeyEvent.ACTION_UP)
+                    nativeEvent(id, EV_BACK, "", "", 0);
+                return true;
+            }
+        });
+        // Like every wxWebView backend, expose window.wx.postMessage() from the start; it raises
+        // wxEVT_WEBVIEW_SCRIPT_MESSAGE_RECEIVED with the handler name "wx" (Orca's pages rely on it).
+        addMessageHandlerNow("wx");
+        root = contentRoot != null ? contentRoot : (FrameLayout) activity.getWindow().getDecorView().findViewById(android.R.id.content);
+        root.addView(web, lp);
+        web.setVisibility(visible ? View.VISIBLE : View.INVISIBLE);
+        nativeEvent(id, EV_CREATED, "", "", 0);
+    }
+
+    // ---- called from the native side (any thread) ----
+
+    public void setBounds(final int x, final int y, final int w, final int h) {
+        activity.runOnUiThread(new Runnable() { public void run() {
+            lp.leftMargin = x; lp.topMargin = y; lp.width = Math.max(w, 1); lp.height = Math.max(h, 1);
+            if (web != null) web.setLayoutParams(lp);
+        }});
+    }
+
+    public void setVisible(final boolean v) {
+        activity.runOnUiThread(new Runnable() { public void run() {
+            visible = v;
+            if (web != null) web.setVisibility(v ? View.VISIBLE : View.INVISIBLE);
+        }});
+    }
+
+    public void requestFocusNative() {
+        activity.runOnUiThread(new Runnable() { public void run() { if (web != null) web.requestFocus(); }});
+    }
+
+    public void loadUrl(final String u) {
+        activity.runOnUiThread(new Runnable() { public void run() { if (web != null) web.loadUrl(u); }});
+    }
+
+    public void loadHtml(final String html, final String base) {
+        activity.runOnUiThread(new Runnable() { public void run() {
+            if (web != null) web.loadDataWithBaseURL(base.isEmpty() ? null : base, html, "text/html", "UTF-8", null);
+        }});
+    }
+
+    public void reload(final boolean noCache) {
+        activity.runOnUiThread(new Runnable() { public void run() {
+            if (web == null) return;
+            if (noCache) web.getSettings().setCacheMode(WebSettings.LOAD_NO_CACHE);
+            web.reload();
+            if (noCache) web.getSettings().setCacheMode(WebSettings.LOAD_DEFAULT);
+        }});
+    }
+
+    public void stop() { activity.runOnUiThread(new Runnable() { public void run() { if (web != null) web.stopLoading(); }}); }
+    public void goBack() { activity.runOnUiThread(new Runnable() { public void run() { if (web != null && web.canGoBack()) web.goBack(); }}); }
+    public void goForward() { activity.runOnUiThread(new Runnable() { public void run() { if (web != null && web.canGoForward()) web.goForward(); }}); }
+    public void clearHistory() { activity.runOnUiThread(new Runnable() { public void run() { if (web != null) web.clearHistory(); }}); }
+
+    public void setZoom(final float f) {
+        activity.runOnUiThread(new Runnable() { public void run() {
+            if (web != null) web.getSettings().setTextZoom(Math.round(f * 100.f));
+        }});
+    }
+
+    public void setUserAgent(final String ua) {
+        userAgent = ua;
+        activity.runOnUiThread(new Runnable() { public void run() { if (web != null) web.getSettings().setUserAgentString(ua); }});
+    }
+
+    public void setDevTools(final boolean on) {
+        devTools = on;
+        activity.runOnUiThread(new Runnable() { public void run() { WebView.setWebContentsDebuggingEnabled(on); }});
+    }
+
+    public void clearBrowsingData() {
+        activity.runOnUiThread(new Runnable() { public void run() {
+            if (web != null) { web.clearCache(true); web.clearFormData(); }
+            CookieManager.getInstance().removeAllCookies(null);
+        }});
+    }
+
+    public void runScript(final String js, final long requestId) {
+        activity.runOnUiThread(new Runnable() { public void run() {
+            if (web == null) { nativeEvent(id, EV_SCRIPT_RESULT, Long.toString(requestId), "", 0); return; }
+            web.evaluateJavascript(js, new android.webkit.ValueCallback<String>() {
+                public void onReceiveValue(String v) {
+                    nativeEvent(id, EV_SCRIPT_RESULT, Long.toString(requestId), decodeJsResult(v), 1);
+                }
+            });
+        }});
+    }
+
+    public void addUserScript(String js) { synchronized (userScripts) { userScripts.add(js); } }
+    public void removeAllUserScripts() { synchronized (userScripts) { userScripts.clear(); } }
+
+    private void addMessageHandlerNow(final String name) {
+        if (web == null || handlers.containsKey(name)) return;
+        Object o = new Object() {
+            @JavascriptInterface public void postMessage(String m) { nativeEvent(id, EV_MESSAGE, name, m, 0); }
+        };
+        handlers.put(name, o);
+        web.addJavascriptInterface(o, name);
+    }
+
+    public void addMessageHandler(final String name) {
+        activity.runOnUiThread(new Runnable() { public void run() { addMessageHandlerNow(name); } });
+    }
+
+    public void removeMessageHandler(final String name) {
+        activity.runOnUiThread(new Runnable() { public void run() {
+            if (web != null && handlers.remove(name) != null) web.removeJavascriptInterface(name);
+        }});
+    }
+
+    public String getUrl() { return url; }
+    public String getTitle() { return title; }
+    public String getUserAgent() { return userAgent; }
+    public boolean isBusy() { return busy; }
+    public boolean canGoBack() { return canBack; }
+    public boolean canGoForward() { return canForward; }
+
+    public void destroy() {
+        destroyed = true;
+        activity.runOnUiThread(new Runnable() { public void run() {
+            if (web != null) {
+                if (root != null) root.removeView(web);
+                web.stopLoading();
+                web.destroy();
+                web = null;
+            }
+        }});
+    }
+
+    // ---- WebView callbacks ----
+
+    private static String decodeJsResult(String v) {
+        if (v == null || v.equals("null")) return "";
+        try {
+            Object o = new JSONTokener(v).nextValue();
+            return o == null ? "" : o.toString();
+        } catch (Exception e) {
+            return v;
+        }
+    }
+
+    private void runUserScripts() {
+        ArrayList<String> copy;
+        synchronized (userScripts) { copy = new ArrayList<>(userScripts); }
+        for (String s : copy) web.evaluateJavascript(s, null);
+    }
+
+    private void updateHistory() {
+        if (web == null) return;
+        canBack = web.canGoBack();
+        canForward = web.canGoForward();
+    }
+
+    private final class Client extends WebViewClient {
+        @Override public boolean shouldOverrideUrlLoading(WebView v, WebResourceRequest r) {
+            nativeEvent(id, EV_NAVIGATING, r.getUrl().toString(), r.isForMainFrame() ? "" : "frame", r.hasGesture() ? 1 : 0);
+            return false;
+        }
+        @Override public void onPageStarted(WebView v, String u, Bitmap icon) {
+            busy = true;
+            url = u;
+            runUserScripts();
+            updateHistory();
+            nativeEvent(id, EV_NAVIGATED, u, "", 0);
+        }
+        @Override public void onPageFinished(WebView v, String u) {
+            busy = false;
+            url = u;
+            updateHistory();
+            nativeEvent(id, EV_LOADED, u, "", 0);
+        }
+        @Override public void onReceivedError(WebView v, WebResourceRequest r, WebResourceError e) {
+            if (!r.isForMainFrame()) return;
+            nativeEvent(id, EV_ERROR, r.getUrl().toString(), String.valueOf(e.getDescription()), e.getErrorCode());
+        }
+    }
+
+    private final class Chrome extends WebChromeClient {
+        @Override public void onReceivedTitle(WebView v, String t) {
+            title = t == null ? "" : t;
+            nativeEvent(id, EV_TITLE, title, "", 0);
+        }
+        @Override public boolean onCreateWindow(WebView v, boolean dialog, boolean userGesture, Message resultMsg) {
+            WebView tmp = new WebView(activity);
+            tmp.setWebViewClient(new WebViewClient() {
+                @Override public boolean shouldOverrideUrlLoading(WebView w, WebResourceRequest r) {
+                    nativeEvent(id, EV_NEWWINDOW, r.getUrl().toString(), "", 0);
+                    return true;
+                }
+                @Override public void onPageStarted(WebView w, String u, Bitmap b) {
+                    nativeEvent(id, EV_NEWWINDOW, u, "", 0);
+                    w.stopLoading();
+                }
+            });
+            ((WebView.WebViewTransport) resultMsg.obj).setWebView(tmp);
+            resultMsg.sendToTarget();
+            return true;
+        }
+    }
+}
diff --git a/src/qt/app.cpp b/src/qt/app.cpp
index 9521282..1f282de 100644
--- a/src/qt/app.cpp
+++ b/src/qt/app.cpp
@@ -14,7 +14,54 @@
 #include "wx/qt/private/utils.h"
 #include "wx/qt/private/converter.h"
 #include <QtCore/QStringList>
+#include <QtCore/QCoreApplication>
 #include <QtWidgets/QApplication>
+#include <QtWidgets/QWidget>
+#include <QtGui/QMouseEvent>
+#include <QtGui/QTouchEvent>
+#include <QtGui/QWindow>
+
+#ifdef __ANDROID__
+// Qt's Android plugin (6.8) maps pointer events for every top-level window except the one at the origin
+// (menus, combo/dropdown popups, dialogs) to a position that is off by the window's position divided by
+// the device pixel ratio. The main window sits at (0, 0), so only secondary windows are affected. Undo the
+// offset on the window-level mouse events, before Qt dispatches them to the widgets inside.
+class wxQtAndroidSecondaryWindowInputFix : public QObject
+{
+protected:
+    bool eventFilter(QObject* obj, QEvent* event) override
+    {
+        switch ( event->type() )
+        {
+            case QEvent::MouseButtonPress:
+            case QEvent::MouseButtonRelease:
+            case QEvent::MouseButtonDblClick:
+            case QEvent::MouseMove:
+                break;
+            default:
+                return false;
+        }
+
+        QWindow* const window = qobject_cast<QWindow*>(obj);
+        if ( !window || m_resending || window->position().isNull() )
+            return false;
+
+        auto* const me = static_cast<QMouseEvent*>(event);
+        const QPointF delta = QPointF(window->position()) / window->devicePixelRatio();
+        QMouseEvent fixed(me->type(), me->position() - delta, me->scenePosition() - delta, me->globalPosition() - delta,
+                          me->button(), me->buttons(), me->modifiers(), me->source(), me->pointingDevice());
+        fixed.setTimestamp(me->timestamp());
+
+        m_resending = true;
+        QCoreApplication::sendEvent(window, &fixed);
+        m_resending = false;
+        return true;
+    }
+
+private:
+    bool m_resending = false;
+};
+#endif // __ANDROID__
