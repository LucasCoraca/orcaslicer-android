+void wxWebViewAndroid::UpdateNativeBounds(bool force)
+{
+    if (!m_impl->valid())
+        return;
+    QWidget* qw = GetHandle();
+    if (!qw)
+        return;
+
+    // The native view is drawn above all Qt content, so it would hide menus, dropdowns and dialogs that open
+    // over it: take it off screen while such a window overlaps it.
+    bool covered = false;
+    if (IsShownOnScreen())
+    {
+        const QRect ours(qw->mapToGlobal(QPoint(0, 0)), qw->size());
+        const QWidget* const ownWindow = qw->window();
+        for (const QWidget* tl : QApplication::topLevelWidgets())
+        {
+            if (tl == ownWindow || !tl->isVisible() || tl->width() <= 1 || tl->height() <= 1)
+                continue;
+            // only what the user is interacting with on top: popups (menus, dropdowns) and modal or active dialogs,
+            // not every secondary window the program keeps around
+            const bool popup = tl->windowType() == Qt::Popup;
+            const bool dialog = (tl->windowType() == Qt::Dialog || tl->windowType() == Qt::Sheet)
+                                && (tl->isModal() || tl->isActiveWindow());
+            if (!popup && !dialog)
+                continue;
+            if (tl->frameGeometry().intersects(ours))
+            {
+                covered = true;
+                break;
+            }
+        }
+    }
+
+    const bool show = IsShownOnScreen() && !covered;
+    if (show != m_impl->visible || force)
+    {
+        m_impl->visible = show;
+        m_impl->bridge.callMethod<void>("setVisible", "(Z)V", jboolean(show));
+    }
+    if (!show)
+        return;
+
+    const qreal dpr = qw->devicePixelRatioF();
+    const QPoint origin = qw->mapToGlobal(QPoint(0, 0));
+    const int x = qRound(origin.x() * dpr), y = qRound(origin.y() * dpr);
+    const int w = qRound(qw->width() * dpr), h = qRound(qw->height() * dpr);
+    const wxString key = wxString::Format("%d,%d,%d,%d", x, y, w, h);
+    if (!force && key == m_impl->lastPostedBounds)
+        return;
+    m_impl->lastPostedBounds = key;
+    m_impl->bridge.callMethod<void>("setBounds", "(IIII)V", jint(x), jint(y), jint(w), jint(h));
+}
+
+void wxWebViewAndroid::DoSetSize(int x, int y, int width, int height, int sizeFlags)
+{
+    wxControl::DoSetSize(x, y, width, height, sizeFlags);
+    UpdateNativeBounds(false);
+}
